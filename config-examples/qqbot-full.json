{
  "qqbot": {
    "enabled": true,
    "defaultAccount": "default",
    "globalDmPolicy": "open",
    "globalGroupPolicy": "open",
    "globalAllowFrom": ["*"],
    "accounts": {
      "default": {
        "enabled": true,
        "name": "主机器人",
        "appId": "YOUR_APP_ID",
        "clientSecret": "请在此填入AppSecret",
        "dmPolicy": "open",
        "groupPolicy": "open",
        "allowFrom": ["*"],
        "defaultTargets": {
          "c2c": "用户OPENID",
          "group": "YOUR_GROUP_OPENID"
        },
        "markdownSupport": true,
        "streaming": {
          "mode": "partial"
        }
      },
      "helper": {
        "enabled": false,
        "name": "辅助机器人",
        "appId": "",
        "clientSecret": "",
        "dmPolicy": "allowlist",
        "groupPolicy": "open",
        "allowFrom": [
          "qqbot:USER_OPENID"
        ],
        "defaultTargets": {
          "group": "另一个群的OPENID"
        }
      }
    }
  },
  "channels": {
    "qqbot": {
      "enabled": true
    }
  },
  "defaultChannel": "qqbot"
}
